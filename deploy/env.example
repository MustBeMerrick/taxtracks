# Server runtime env — copied to ~/apps/taxtracks/env by `deploy.sh init`.
# Fill in real values on the server; this template holds no secrets.

# The public HTTPS address. Passkeys are bound to this hostname, so register
# them while signed in here (other addresses still work with the password).
APP_URL=https://taxtracks.mustbemerrick.com

# Random secret used to sign the session cookie. Generate with
# `openssl rand -hex 32`. Changing this signs everyone out.
AUTH_SESSION_SECRET=

# scrypt hash of the login password (salt:hash, hex). Generate on the Mac with
# `npm run auth:hash -- '<password>'` and keep the plaintext in your password
# manager. Without it, password login is disabled.
AUTH_PASSWORD_HASH=
